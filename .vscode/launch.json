{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug memsim (demo)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/memsim",
      "args": ["--demo"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "C/C++: build (make)",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug memsim (custom args)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/memsim",
      "args": ["-l1", "16K,64,4,lru", "-g", "col", "-p", "512", "-n", "50000", "-v"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "C/C++: build (make)"
    }
  ]
}
