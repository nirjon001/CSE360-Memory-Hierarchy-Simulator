{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C/C++: build (make)",
      "type": "shell",
      "command": "make",
      "args": [],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "Compile the memory hierarchy simulator with gcc"
    },
    {
      "label": "C/C++: debug build",
      "type": "shell",
      "command": "make debug",
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Run: demo comparison",
      "type": "shell",
      "command": "./memsim --demo",
      "dependsOn": "C/C++: build (make)",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run: current configuration",
      "type": "shell",
      "command": "./memsim -l1 16K,64,1 -l2 256K,64,8 -g row -p 512 -n 100000",
      "dependsOn": "C/C++: build (make)",
      "problemMatcher": []
    },
    {
      "label": "Run active C file",
      "type": "shell",
      "command": "gcc -std=c11 -Wall -Wextra -g '${file}' -o '${fileDirname}/${fileBasenameNoExtension}' && '${fileDirname}/${fileBasenameNoExtension}'",
      "problemMatcher": ["$gcc"],
      "group": "test",
      "detail": "Compile and run only the file currently open in the editor"
    },
    {
      "label": "Clean build artefacts",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    }
  ]
}
